---
// Botón del encabezado hacia las imágenes para redes de esta sección (/compartir/).
interface Props {
  seccion: string;
}
const { seccion } = Astro.props;
---
<a href={`/compartir/#${seccion}`} class="boton mt-5 bg-white/15 text-sm text-white hover:bg-white/25">
  <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" /></svg>
  Imágenes para Facebook
</a>
