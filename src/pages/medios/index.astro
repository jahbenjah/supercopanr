---
import Base from '../../layouts/Base.astro';
import Encabezado from '../../components/Encabezado.astro';
import MedioBadge from '../../components/MedioBadge.astro';
import { contacto, datos, redesDeMedio } from '../../lib/datos';

const d = await datos();
const alta = contacto(d, `Hola, tengo un medio y quiero cubrir la ${d.torneo.nombre}`);
---
<Base title="Medios" description={`Directorio de medios que cubren la ${d.torneo.nombre}: transmisiones, noticias y redes sociales.`}>
  <Encabezado titulo="Medios" subtitulo={`Páginas, transmisiones y noticias que cubren la ${d.torneo.nombre}. ¡Síguelos!`} />
  <div class="contenedor py-8">
    {d.medios.length === 0 && (
      <p class="rounded-xl border-l-4 border-oro bg-amber-50 p-4">Aquí aparecerán los medios que cubren el torneo.</p>
    )}
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {d.medios.map((m) => (
        <li>
          <a href={`/medios/${m.id}/`} class="tarjeta flex h-full flex-col items-center gap-3 p-5 text-center no-underline transition hover:border-cancha hover:shadow">
            <MedioBadge medio={m} size={72} enlace={false} />
            <span class="font-display text-xl font-bold uppercase">{m.nombre}</span>
            {m.descripcion && <span class="line-clamp-2 text-sm text-stone-600">{m.descripcion}</span>}
            <span class="mt-auto text-xs text-stone-500">{redesDeMedio(m).map((r) => r.nombre).join(' · ')}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-center text-sm text-stone-500">
      ¿Tienes un medio y cubres el torneo? <a href={alta.href} target="_blank" rel="noopener" class="font-semibold text-cancha">Escríbenos por {alta.canal}</a> para aparecer en el directorio.
    </p>
  </div>
</Base>
