---
import Base from '../../layouts/Base.astro';
import MedioBadge from '../../components/MedioBadge.astro';
import RedesMedio from '../../components/RedesMedio.astro';
import { datos, redesDeMedio } from '../../lib/datos';

export async function getStaticPaths() {
  const d = await datos();
  return d.medios.map((m) => ({ params: { id: m.id } }));
}

const d = await datos();
const m = d.por.medios.get(Astro.params.id)!;
const descripcion = m.descripcion ?? `${m.nombre}, medio que cubre la ${d.torneo.nombre}.`;
const otros = d.medios.filter((x) => x.id !== m.id);
const pagina = new URL(Astro.url.pathname, Astro.site).href;

// Datos estructurados para Google: el medio y sus perfiles sociales.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  '@id': `${pagina}#medio`,
  name: m.nombre,
  description: descripcion,
  url: m.sitio_web ?? pagina,
  ...(m.logo && { logo: new URL(m.logo, Astro.site).href, image: new URL(`/og/medios/${m.id}.png`, Astro.site).href }),
  sameAs: redesDeMedio(m).filter((r) => r.id !== 'sitio_web').map((r) => r.url),
  ...(m.whatsapp && { contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', telephone: `+${m.whatsapp}` } }),
};
---
<Base title={m.nombre} description={descripcion} image={m.logo ? `/og/medios/${m.id}.png` : undefined}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="text-white" style={`background:linear-gradient(135deg, ${m.color}, #0a0907)`}>
    <div class="contenedor flex flex-col gap-6 py-10 sm:flex-row sm:items-center">
      <MedioBadge medio={m} size={112} enlace={false} />
      <div class="flex-1">
        <p class="text-sm text-white/80">Medio de comunicación</p>
        <h1 class="text-4xl sm:text-5xl">{m.nombre}</h1>
        <p class="mt-2 max-w-2xl text-white/90">{descripcion}</p>
      </div>
    </div>
  </section>

  <div class="contenedor grid gap-10 py-8 lg:grid-cols-3">
    <div class="space-y-10 lg:col-span-2">
      <section>
        <h2 class="titulo-seccion">Síguelos</h2>
        <RedesMedio medio={m} />
        {redesDeMedio(m).length === 0 && !m.whatsapp && <p class="text-stone-500">Redes sociales por publicar.</p>}
      </section>
      {m.fotos.length > 0 && (
        <section>
          <h2 class="titulo-seccion">Galería</h2>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            {m.fotos.map((f) => <img src={f} alt={`Foto de ${m.nombre}`} class="aspect-square w-full rounded-lg object-cover" loading="lazy" />)}
          </div>
        </section>
      )}
    </div>
    <aside class="space-y-4">
      <h2 class="text-lg text-cancha-oscuro">Otros medios</h2>
      <ul class="space-y-2">
        {otros.map((x) => <li class="tarjeta p-3"><MedioBadge medio={x} size={36} conNombre /></li>)}
      </ul>
      <a href="/medios/" class="text-sm font-semibold text-cancha">← Todos los medios</a>
    </aside>
  </div>
</Base>
