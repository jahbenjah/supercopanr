---
import Base from '../layouts/Base.astro';
import MatchCard from '../components/MatchCard.astro';
import StandingsTable from '../components/StandingsTable.astro';
import SponsorSlot from '../components/SponsorSlot.astro';
import TeamBadge from '../components/TeamBadge.astro';
import CuentaRegresiva from '../components/CuentaRegresiva.astro';
import ProgramacionGeneral from '../components/ProgramacionGeneral.astro';
import { cap, datos, fechaLarga, fechaSinAnio, mismoDia, pesos } from '../lib/datos';

const d = await datos();
const { torneo } = d;
const proximos = d.proximaFecha ? d.partidos.filter((p) => mismoDia(p.fecha, d.proximaFecha!)) : [];
const resultados = d.ultimaFecha
  ? d.partidos.filter((p) => mismoDia(p.fecha, d.ultimaFecha!) && p.estado !== 'programado')
  : [];
const topGoleo = d.goleadores.slice(0, 5);
const totalPartidos = torneo.programacion.reduce((s, p) => s + p.partidos, 0);
const campeon = torneo.premios[0];
const cifras = [
  [torneo.total_equipos, 'Equipos'],
  [torneo.categorias[0].grupos.length, 'Grupos'],
  [totalPartidos, 'Partidos'],
  [campeon.premio, `Premio al ${campeon.lugar.toLowerCase()}`],
];
---
<Base>
  <section class="relative overflow-hidden bg-gradient-to-br from-cancha-oscuro via-cancha to-cancha-oscuro text-white">
    <div class="absolute inset-0 opacity-10" style="background:repeating-linear-gradient(90deg,#fff 0 2px,transparent 2px 80px)"></div>
    <div class="contenedor relative grid gap-10 py-12 sm:py-16 lg:grid-cols-[1.3fr_1fr] lg:items-center">
      <div>
        <p class="chip bg-oro text-tinta">{torneo.edicion} · {torneo.temporada}</p>
        <h1 class="mt-3 text-5xl leading-none sm:text-7xl">{torneo.nombre}</h1>
        <p class="mt-4 max-w-2xl text-lg text-white/85">{torneo.descripcion}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/inscripcion/" class="boton bg-oro text-tinta hover:brightness-110">Inscribir a mi equipo</a>
          <a href={torneo.bases_pdf} class="boton border border-white/50 text-white hover:bg-white/10" data-track="descarga_bases" data-id="home">Descargar bases (PDF)</a>
        </div>
      </div>
      <CuentaRegresiva />
    </div>
    <div class="relative border-t border-white/15 bg-black/15">
      <dl class="contenedor grid grid-cols-2 gap-4 py-5 sm:grid-cols-4">
        {cifras.map(([n, t]) => (
          <div>
            <dt class="text-xs uppercase tracking-wider text-white/70">{t}</dt>
            <dd class="font-display text-3xl font-bold text-oro sm:text-4xl">{n}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="contenedor">
    <a href="/inscripcion/" class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-xl border-l-4 border-red-600 bg-red-50 px-4 py-3 text-red-900 no-underline hover:bg-red-100">
      <strong class="uppercase">Fecha límite de inscripción:</strong>
      <span>{fechaLarga(torneo.fecha_limite_inscripcion)}.</span>
      <span class="text-sm">Tu lugar se confirma solo al cubrir la inscripción →</span>
    </a>
  </div>

  {(proximos.length > 0 || resultados.length > 0) && (
    <div class="contenedor mt-10 grid gap-10 lg:grid-cols-3">
      <div class="space-y-10 lg:col-span-2">
        {proximos.length > 0 && (
          <section>
            <h2 class="titulo-seccion">Próximos partidos · {fechaSinAnio(d.proximaFecha!)}</h2>
            <div class="grid gap-3 sm:grid-cols-2">{proximos.map((p) => <MatchCard partido={p} mostrarFecha={false} />)}</div>
          </section>
        )}
        {resultados.length > 0 && (
          <section>
            <h2 class="titulo-seccion">Resultados · {fechaSinAnio(d.ultimaFecha!)}</h2>
            <div class="grid gap-3 sm:grid-cols-2">{resultados.map((p) => <MatchCard partido={p} mostrarFecha={false} />)}</div>
            <a href="/resultados/" class="mt-3 inline-block font-semibold text-cancha">Todos los resultados →</a>
          </section>
        )}
      </div>
      <aside class="space-y-10">
        {topGoleo.length > 0 && (
          <section>
            <h2 class="titulo-seccion">Goleadores</h2>
            <ol class="tarjeta divide-y divide-stone-100">
              {topGoleo.map((g, i) => {
                const j = d.por.jugadores.get(g.jugador_id)!;
                return (
                  <li class="flex items-center gap-3 px-3 py-2">
                    <span class="w-5 font-display text-lg font-bold text-stone-400">{i + 1}</span>
                    <TeamBadge equipo={d.por.equipos.get(g.equipo_id)!} size={24} />
                    <a href={`/jugadores/${j.id}/`} class="flex-1 truncate font-semibold no-underline hover:underline">{j.nombre}</a>
                    <span class="font-display text-xl font-bold text-cancha">{g.goles}</span>
                  </li>
                );
              })}
            </ol>
          </section>
        )}
        {d.posiciones.length > 0 && <a href="/posiciones/" class="boton-primario w-full">Ver tabla de posiciones</a>}
      </aside>
    </div>
  )}

  {d.posiciones.length > 0 && (
    <section class="contenedor mt-10">
      <h2 class="titulo-seccion">Grupos</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{d.posiciones.map((t) => <StandingsTable tabla={t} compacta />)}</div>
    </section>
  )}

  <div class="contenedor py-10">
    <SponsorSlot ubicacion="home-top" />
  </div>

  <div class="contenedor grid gap-10 lg:grid-cols-2">
    <section>
      <h2 class="titulo-seccion">Fechas clave</h2>
      <ol class="relative space-y-5 border-l-2 border-stone-200 pl-6">
        {torneo.fechas.map((f) => (
          <li class="relative">
            <span class:list={['absolute -left-[33px] top-1 h-4 w-4 rounded-full ring-4 ring-stone-50', f.critica ? 'bg-red-600' : 'bg-cancha']}></span>
            <p class:list={['text-sm font-semibold', f.critica ? 'text-red-700' : 'text-stone-500']}>{cap(fechaLarga(f.fecha))}</p>
            <p class="font-display text-xl font-bold uppercase">{f.titulo}</p>
            {f.descripcion && <p class="text-sm text-stone-600">{f.descripcion}</p>}
          </li>
        ))}
      </ol>
    </section>
    <section>
      <h2 class="titulo-seccion">Programación general</h2>
      <ProgramacionGeneral />
      <p class="mt-3 text-sm text-stone-500">{torneo.formato}</p>
    </section>
  </div>

  <div class="contenedor mt-12 grid gap-10 lg:grid-cols-2">
    <section>
      <h2 class="titulo-seccion">Costos</h2>
      <ul class="tarjeta divide-y divide-stone-100">
        {torneo.costos.map((c) => (
          <li class="flex items-center justify-between gap-4 px-4 py-3">
            <div>
              <p class="font-semibold">{c.concepto}</p>
              {c.detalle && <p class="text-sm text-stone-500">{c.detalle}</p>}
            </div>
            <span class="font-display text-2xl font-bold text-cancha">{pesos(c.monto)}</span>
          </li>
        ))}
      </ul>
      <a href="/inscripcion/" class="mt-3 inline-block font-semibold text-cancha">Cómo inscribirse y fechas de pago →</a>
    </section>
    <section>
      <h2 class="titulo-seccion">Premios</h2>
      <ul class="grid gap-3">
        {torneo.premios.map((p, i) => (
          <li class:list={['tarjeta flex items-center justify-between gap-4 px-5 py-4', i === 0 && 'border-2 border-oro bg-gradient-to-r from-amber-50 to-white']}>
            <span class="flex items-center gap-3 font-display text-xl font-bold uppercase">
              <span class:list={['inline-flex h-8 w-8 items-center justify-center rounded-full text-base', ['bg-oro text-tinta', 'bg-stone-300 text-tinta', 'bg-amber-700 text-white'][i] ?? 'bg-stone-200']}>{i + 1}</span>
              {p.lugar}
            </span>
            <span class:list={['font-display font-bold', i === 0 ? 'text-4xl text-cancha' : 'text-xl text-stone-500']}>{p.premio}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <section class="contenedor mt-14">
    <div class="tarjeta flex flex-col items-start gap-4 bg-gradient-to-r from-tinta to-cancha-oscuro p-6 text-white sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-2xl">¿Tienes un negocio en Nicolás Romero?</h2>
        <p class="text-white/80">{torneo.total_equipos} equipos, {totalPartidos} partidos y cientos de aficionados. Pon tu marca en la Supercopa.</p>
      </div>
      <a href="/anunciate/" class="boton bg-oro text-tinta hover:brightness-110">Ver opciones de patrocinio</a>
    </div>
  </section>
</Base>
