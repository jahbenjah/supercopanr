---
import Base from '../../layouts/Base.astro';
import Encabezado from '../../components/Encabezado.astro';
import SponsorBadge from '../../components/SponsorBadge.astro';
import { contacto, datos, pesos } from '../../lib/datos';

const d = await datos();
const niveles = [
  ['oro', 'Patrocinadores Oro'],
  ['plata', 'Patrocinadores Plata'],
  ['bronce', 'Patrocinadores Bronce'],
  ['equipo', 'Patrocinadores de equipos'],
] as const;
const equiposDe = (id: string) => d.equipos.filter((e) => e.patrocinadores_ids.includes(id));
const grupos = niveles
  .map(([nivel, titulo]) => ({
    titulo,
    lista: d.patrocinadores.filter((p) => p.nivel === nivel).sort((a, b) => a.nombre.localeCompare(b.nombre, 'es')),
  }))
  .filter((g) => g.lista.length > 0);
const pedido = (nombre: string) => contacto(d, `Hola, me interesa el ${nombre} de la tienda de la ${d.torneo.nombre}.`);
---
<Base title="Patrocinadores" description={`Las marcas que hacen posible la ${d.torneo.nombre}.`}>
  <Encabezado titulo="Patrocinadores" subtitulo="Gracias a las marcas que apoyan el fútbol amateur de Nicolás Romero. ¡Apóyalos tú también!" />
  <div class="contenedor space-y-12 py-10">
    {grupos.length === 0 && (
      <p class="rounded-xl border-l-4 border-oro bg-amber-50 p-4">
        Aquí aparecerán las marcas que apoyan el torneo. <a href="/anunciate/" class="font-semibold text-cancha">¿Quieres que la tuya sea la primera?</a>
      </p>
    )}
    {grupos.map((g) => (
      <section>
        <h2 class="titulo-seccion">{g.titulo}</h2>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {g.lista.map((p) => {
            const equipos = equiposDe(p.id);
            return (
              <li>
                <a href={`/patrocinadores/${p.id}/`} class="tarjeta flex h-full flex-col items-center gap-3 p-5 text-center no-underline transition hover:border-cancha hover:shadow">
                  <SponsorBadge patrocinador={p} />
                  <span class="font-display text-xl font-bold uppercase">{p.nombre}</span>
                  {equipos.length > 0 && (
                    <span class="text-sm text-stone-500">Patrocina a {equipos.map((e) => e.nombre).join(', ')}</span>
                  )}
                  {p.nivel !== 'equipo' && <span class="chip bg-oro/20 text-amber-800">★ Patrocinador {p.nivel}</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
    {d.productos.length > 0 && (
      <section id="tienda" class="scroll-mt-24">
        <h2 class="titulo-seccion">Tienda oficial</h2>
        <p class="mb-6 text-stone-600">Balones a la venta durante el torneo. Pide el tuyo por mensaje y recógelo en la cancha.</p>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {d.productos.map((p) => {
            const c = pedido(p.nombre);
            return (
              <li class="tarjeta flex h-full flex-col overflow-hidden">
                <div class="relative aspect-square bg-stone-100">
                  {p.foto
                    ? <img src={p.foto} alt={p.nombre} width="800" height="800" loading="lazy" decoding="async" class="h-full w-full object-cover" />
                    : <span class="flex h-full items-center justify-center text-6xl" aria-hidden="true">⚽</span>}
                  {!p.disponible && <span class="chip absolute left-3 top-3 bg-stone-900 text-white">Agotado</span>}
                </div>
                <div class="flex flex-1 flex-col gap-2 p-5">
                  {p.marca && <span class="text-xs font-semibold uppercase tracking-wide text-stone-500">{p.marca}</span>}
                  <h3 class="font-display text-xl font-bold uppercase">{p.nombre}</h3>
                  {p.descripcion && <p class="text-sm text-stone-600">{p.descripcion}</p>}
                  {p.detalles.length > 0 && (
                    <ul class="list-inside list-disc text-sm text-stone-600">
                      {p.detalles.map((x) => <li>{x}</li>)}
                    </ul>
                  )}
                  <div class="mt-auto flex items-center justify-between gap-3 pt-3">
                    <span class="font-display text-3xl font-bold text-cancha">{pesos(p.precio)}</span>
                    {p.disponible && (
                      <a href={c.href} target="_blank" rel="noopener" data-track="click_producto" data-id={p.id} class="boton-primario">Pedir por {c.canal}</a>
                    )}
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )}
    <div class="text-center">
      <a href="/anunciate/" class="boton-primario">Quiero ser patrocinador</a>
    </div>
  </div>
</Base>
