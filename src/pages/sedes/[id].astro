---
import Base from '../../layouts/Base.astro';
import Encabezado from '../../components/Encabezado.astro';
import MatchCard from '../../components/MatchCard.astro';
import { datos } from '../../lib/datos';

export async function getStaticPaths() {
  const d = await datos();
  return d.sedes.map((s) => ({ params: { id: s.id } }));
}

const d = await datos();
const s = d.por.sedes.get(Astro.params.id)!;
const partidos = d.partidos.filter((p) => p.sede_id === s.id);
const mapa = s.lat != null && s.lng != null
  ? `https://maps.google.com/maps?q=${s.lat},${s.lng}&z=16&output=embed`
  : `https://maps.google.com/maps?q=${encodeURIComponent(s.direccion)}&z=16&output=embed`;
---
<Base title={s.nombre} description={`${s.nombre}: ${s.direccion}. Partidos de la ${d.torneo.nombre} en esta sede.`}>
  <Encabezado titulo={s.nombre} subtitulo={s.direccion}>
    <a href={s.maps_url} target="_blank" rel="noopener" class="boton mt-4 bg-white text-cancha-oscuro hover:bg-stone-100">Cómo llegar</a>
  </Encabezado>
  <div class="contenedor grid gap-8 py-8 lg:grid-cols-2">
    <iframe src={mapa} title={`Mapa de ${s.nombre}`} class="tarjeta h-80 w-full" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    <div>
      <p class="flex flex-wrap gap-2">
        {s.cancha && <span class="chip">{s.cancha}</span>}
        {s.servicios.map((x) => <span class="chip">{x}</span>)}
      </p>
      <h2 class="titulo-seccion mt-6">Partidos en esta sede</h2>
      <div class="grid gap-3">{partidos.map((p) => <MatchCard partido={p} />)}</div>
    </div>
  </div>
</Base>
