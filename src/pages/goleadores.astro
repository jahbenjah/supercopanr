---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import TeamBadge from '../components/TeamBadge.astro';
import SponsorSlot from '../components/SponsorSlot.astro';
import { datos } from '../lib/datos';

const d = await datos();
---
<Base title="Goleadores" description={`Tabla de goleo de la ${d.torneo.nombre}.`}>
  <Encabezado titulo="Goleadores" subtitulo="Tabla de goleo individual." />
  <div class="contenedor py-8">
    <div class="tarjeta overflow-x-auto">
      <table class="tabla">
        <thead><tr><th class="w-10">#</th><th class="text-left!">Jugador</th><th class="text-left!">Equipo</th><th>Goles</th></tr></thead>
        <tbody>
          {d.goleadores.map((g, i) => {
            const j = d.por.jugadores.get(g.jugador_id)!;
            return (
              <tr>
                <td class="font-display text-lg font-bold text-stone-400">{i + 1}</td>
                <td class="text-left!"><a href={`/jugadores/${j.id}/`} class="font-semibold">{j.nombre}</a></td>
                <td class="text-left!"><TeamBadge equipo={d.por.equipos.get(g.equipo_id)!} conNombre size={24} /></td>
                <td class="font-display text-xl font-bold text-cancha">{g.goles}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
      {d.goleadores.length === 0 && <p class="p-4 text-stone-500">Aún no hay goles registrados. La tabla se actualiza después de cada fecha.</p>}
    </div>
    <div class="mt-8"><SponsorSlot ubicacion="tabla" /></div>
  </div>
</Base>
