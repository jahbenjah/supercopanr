---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import MatchCard from '../components/MatchCard.astro';
import SponsorSlot from '../components/SponsorSlot.astro';
import ProgramacionGeneral from '../components/ProgramacionGeneral.astro';
import { cap, datos, fechaLarga, fechaSinAnio, mismoDia } from '../lib/datos';
import { NOMBRE_FASE } from '../lib/estadisticas';

const d = await datos();
const dias = [...new Set(d.partidos.map((p) => p.fecha.toISOString().slice(0, 10)))].sort();
const grupos = [...new Set(d.partidos.map((p) => p.grupo).filter(Boolean))].sort();
const sorteo = d.torneo.fechas.find((f) => f.id === 'sorteo');
---
<Base title="Calendario" description={`Calendario de partidos de la ${d.torneo.nombre} ${d.torneo.temporada}: fechas, horarios y sedes.`}>
  <Encabezado titulo="Calendario" subtitulo="Partidos por fecha, con horarios y sedes.">
    {grupos.length > 1 && (
      <label class="mt-4 inline-flex items-center gap-2 text-sm">
        Grupo
        <select id="filtro-grupo" class="rounded bg-white px-2 py-1 text-tinta">
          <option value="">Todos</option>
          {grupos.map((g) => <option value={g}>Grupo {g}</option>)}
        </select>
      </label>
    )}
  </Encabezado>
  <div class="contenedor space-y-10 py-8">
    {dias.length === 0 && (
      <section>
        <p class="mb-6 rounded-xl border-l-4 border-oro bg-amber-50 p-4">
          Los partidos, horarios y sedes se publican después del <strong>{sorteo?.titulo.toLowerCase() ?? 'sorteo'}</strong>
          {sorteo && <> del {fechaLarga(sorteo.fecha)}</>}. Esta es la programación oficial:
        </p>
        <ProgramacionGeneral />
      </section>
    )}
    {dias.map((dia) => {
      const ps = d.partidos.filter((p) => p.fecha.toISOString().slice(0, 10) === dia);
      const fases = [...new Set(ps.map((p) => NOMBRE_FASE[p.fase]))].join(' · ');
      const esProxima = d.proximaFecha && mismoDia(ps[0].fecha, d.proximaFecha);
      const patrocinador = ps.find((p) => p.patrocinador_jornada_id)?.patrocinador_jornada_id;
      return (
        <section id={dia} class:list={['scroll-mt-4', esProxima && 'rounded-xl ring-2 ring-oro ring-offset-8 ring-offset-stone-50']}>
          <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="titulo-seccion mb-0!">
              {cap(fechaSinAnio(ps[0].fecha))}
              {esProxima && <span class="chip ml-2 bg-oro text-tinta normal-case">Próxima fecha</span>}
            </h2>
            <p class="text-sm font-semibold text-stone-500">{fases}</p>
          </div>
          {patrocinador && <p class="mb-3 text-sm text-stone-600">Fecha presentada por <strong>{d.por.patrocinadores.get(patrocinador)!.nombre}</strong></p>}
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {ps.map((p) => <div data-grupo={p.grupo ?? ''}><MatchCard partido={p} mostrarFecha={false} /></div>)}
          </div>
        </section>
      );
    })}
    <SponsorSlot ubicacion="jornada" />
  </div>
  <script>
    const sel = document.getElementById('filtro-grupo') as HTMLSelectElement | null;
    sel?.addEventListener('change', () => {
      document.querySelectorAll<HTMLElement>('[data-grupo]').forEach((el) => {
        el.hidden = !!sel.value && el.dataset.grupo !== sel.value;
      });
    });
  </script>
</Base>
